# Copy to backend/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
# Max JSON body size. Long conversations sent for AI generation can be a few MB.
JSON_LIMIT=5mb

# --- Storage ---
# MongoDB connection string (local or Atlas). Without it, /handoffs and /memory return 503
# and the extension keeps everything in local browser storage.
MONGO_URI=mongodb://127.0.0.1:27017/context-memory-assistant
# mongo (default) | memory  (memory = non-persistent, for local testing only)
STORAGE=mongo

# --- CORS ---
# Comma-separated Chrome extension IDs allowed to call the API (see chrome://extensions).
# Leave empty during development to allow any chrome-extension:// origin.
ALLOWED_EXTENSION_IDS=
# Optional web dashboard origin, e.g. http://localhost:3000
DASHBOARD_URL=
# Extra allowed web origins, comma-separated
ALLOWED_ORIGINS=

# --- AI handoff generation (optional) ---
# gemini | openai | anthropic | none. If unset, the first provider with a key below is used.
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# LLM_MODEL=              # defaults: gemini-2.5-flash | gpt-4.1-mini | claude-sonnet-5-5
# LLM_BASE_URL=           # e.g. an OpenAI-compatible server
# LLM_TIMEOUT_MS=90000
# LLM_MAX_INPUT_CHARS=120000   # per-chunk transcript budget
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_MAX_CHUNKS=12            # longer conversations fall back to deterministic generation
# LLM_CONCURRENCY=2
# GEMINI_API_KEY is also used for memory embeddings; without it memory search uses keywords.

# --- Rate limiting (per install token, per window) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
GENERATE_RATE_LIMIT_MAX=10

# --- Migration ---
# Memories saved before per-install access tokens have userId "local". Set to true,
# call POST /memory/claim-legacy once from your extension's token, then set back to false.
ALLOW_LEGACY_MEMORY_CLAIM=false
