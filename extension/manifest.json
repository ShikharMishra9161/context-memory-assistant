{
  "manifest_version": 3,
  "name": "Context Memory Assistant",
  "version": "1.1.0",
  "description": "Extract the context of a ChatGPT, Claude or Gemini conversation and continue it in a new chat without losing your project state.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "alarms", "clipboardWrite"],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://context-memory-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "content/injector-utils.js",
        "content/extract-core.js",
        "content/adapters/chatgpt-adapter.js",
        "content/extract-listener.js",
        "content/chatgpt-injector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "content/injector-utils.js",
        "content/extract-core.js",
        "content/adapters/gemini-adapter.js",
        "content/extract-listener.js",
        "content/gemini-injector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/injector-utils.js",
        "content/extract-core.js",
        "content/adapters/claude-adapter.js",
        "content/extract-listener.js",
        "content/claude-injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist-popup/index.html"
  }
}
